<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HomelabAtlas</RootNamespace>
    <AssemblyName>HomelabAtlas</AssemblyName>
    <Version>1.1.1</Version>
    <UserSecretsId>287dce21-1a6e-4226-8b11-521cc42a4ad6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language files: one JSON file per language (en.json, de.json, ...).
         Removed first because the Web SDK already includes **/*.json as Content (avoids NETSDK1022 duplicates). -->
    <Content Remove="Locales\**" />
    <Content Include="Locales\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
