@inject Texts L

<div class="modal-backdrop">
    <div class="modal" @onkeydown="OnKey">
        <div class="modal-head">
            <h2>@Title</h2>
            <button class="btn small" title="@L["Common.Close"]" @onclick="OnCancel">✕</button>
        </div>
        <div class="form">
            @ChildContent
        </div>
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert err">@Error</div>
        }
        <div class="toolbar">
            <button class="btn primary" @onclick="OnSave">@L["Common.Save"]</button>
            <button class="btn" @onclick="OnCancel">@L["Common.Cancel"]</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
