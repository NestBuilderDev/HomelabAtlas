@typeparam TEntity where TEntity : SyncedEntity
@inject Texts L
@inject IDbContextFactory<HomelabAtlasDbContext> DbFactory

<div class="details-grid">
    <div>
        <h3>@L["Details.Notes"] @(Item.IsManual ? "" : L["Details.NotesKept"])</h3>
        <textarea rows="6" @bind="notes" placeholder="@L["Details.NotesPlaceholder"]"></textarea>
        <div class="toolbar">
            <button class="btn primary small" @onclick="SaveNotes">@L["Details.SaveNote"]</button>
            @if (saved)
            {
                <span class="ok-text">@L["Details.Saved"]</span>
            }
        </div>
        <div class="muted small">
            @if (Item.IsManual)
            {
                @(L["Details.ManualInfo", Fmt.Time(Item.FirstSeenUtc), Fmt.Time(Item.LastSeenUtc)])
            }
            else
            {
                @(L["Details.ExternalId", Item.ExternalId])<br />
                @(L["Details.Seen", Fmt.Time(Item.FirstSeenUtc), Fmt.Time(Item.LastSeenUtc)])
            }
        </div>
    </div>
    <div>
        @if (Item.IsManual)
        {
            <h3>@L["Details.ManualEntry"]</h3>
            <p class="muted">@L["Details.ManualText"]</p>
        }
        else
        {
            <h3>@(L["Details.RawData", L.Source(Item)])</h3>
            <pre class="json">@pretty</pre>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TEntity Item { get; set; } = default!;

    private string? notes;
    private string pretty = "";
    private bool saved;
    private int loadedId = -1;

    protected override void OnParametersSet()
    {
        if (loadedId == Item.Id) return;
        loadedId = Item.Id;
        notes = Item.Notes;
        pretty = JsonExt.Pretty(Item.RawJson);
        saved = false;
    }

    private async Task SaveNotes()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Set<TEntity>().FindAsync(Item.Id);
        if (entity is null) return;
        entity.Notes = Fmt.Clean(notes);
        await db.SaveChangesAsync();
        Item.Notes = entity.Notes;
        saved = true;
    }
}
