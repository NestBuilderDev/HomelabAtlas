@inject Texts L
@inject NavigationManager Nav

<div class="filterbar">
    <select value="@GatewayId" @onchange="OnGatewayChanged">
        <option value="0">@L["Filter.AllLocations"]</option>
        @foreach (var g in Gateways)
        {
            <option value="@g.Id">@g.Name</option>
        }
    </select>
    <input type="search" placeholder="@L["Filter.Search"]" value="@Search" @oninput="OnSearch" />
    @ChildContent
</div>

@code {
    [Parameter] public List<Gateway> Gateways { get; set; } = new();
    [Parameter] public int GatewayId { get; set; }
    [Parameter] public EventCallback<int> GatewayIdChanged { get; set; }
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnGatewayChanged(ChangeEventArgs e)
    {
        var value = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        var uri = new Uri(Nav.Uri);
        var target = value == 0 ? uri.AbsolutePath : $"{uri.AbsolutePath}?gatewayId={value}";

        Nav.NavigateTo(target, replace: true);
        await GatewayIdChanged.InvokeAsync(value);
    }

    private Task OnSearch(ChangeEventArgs e) => SearchChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
