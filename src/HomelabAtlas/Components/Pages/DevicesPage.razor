@page "/devices"
@inherits ListPageBase<DeviceEntry>

<PageTitle>@L["Nav.Devices"] – HomelabAtlas</PageTitle>

<h1>@L["Nav.Devices"]</h1>

<FilterBar Gateways="GatewayList" @bind-GatewayId="GatewayFilter" @bind-Search="Search">
    <button class="btn primary" @onclick="NewItem">+ @L["Devices.Add"]</button>
</FilterBar>

<DataGrid TItem="DeviceEntry" Items="Filtered" Columns="Columns" Key="x => x.Id"
          RowClass="RowCss" CanEdit="IsEditable" OnEdit="EditItem" OnDelete="DeleteAsync">
    <DetailTemplate Context="d">
        <RowDetails TEntity="DeviceEntry" Item="d" />
    </DetailTemplate>
</DataGrid>

@if (Editing is not null)
{
    <EditDialog Title="@EditTitle" Error="@EditError" OnSave="SaveAsync" OnCancel="CancelEdit">
        <SiteSelect Sites="SiteList" @bind-Value="Editing.SiteId" />
        <label>@L["Field.Name"]<input @bind="Editing.Name" placeholder="@L["Devices.NamePh"]" /></label>
        <label>@L["Field.DeviceType"]<input @bind="Editing.DeviceType" list="device-types" /></label>
        <datalist id="device-types">
            @foreach (var key in DeviceTypeKeys)
            {
                <option value="@L[key]"></option>
            }
        </datalist>
        <label>@L["Field.Manufacturer"]<input @bind="Editing.Manufacturer" placeholder="Cisco, HPE, Synology, AVM …" /></label>
        <label>@L["Field.Model"]<input @bind="Editing.Model" /></label>
        <label>@L["Field.Ip"]<input @bind="Editing.IpAddress" placeholder="10.20.30.5" /></label>
        <label>@L["Field.Mac"]<input @bind="Editing.MacAddress" placeholder="aa:bb:cc:dd:ee:ff" /></label>
        <label>@L["Field.State"]<input @bind="Editing.State" list="device-states" /></label>
        <datalist id="device-states">
            <option value="ONLINE"></option><option value="OFFLINE"></option><option value="PLANNED"></option><option value="DECOMMISSIONED"></option>
        </datalist>
        <label>@L["Field.Firmware"]<input @bind="Editing.FirmwareVersion" /></label>
        <label>@L["Field.MountLocation"]<input @bind="Editing.Location" placeholder="@L["Devices.LocationPh"]" /></label>
        <label>@L["Field.Features"]<input @bind="Editing.Features" placeholder="switching, routing, PoE" /></label>
        <label class="wide">@L["Field.Notes"]<textarea rows="3" @bind="Editing.Notes"></textarea></label>
    </EditDialog>
}

@code {
    private static readonly string[] DeviceTypeKeys =
    [
        "DeviceType.Switch", "DeviceType.Router", "DeviceType.Firewall", "DeviceType.AccessPoint", "DeviceType.Server",
        "DeviceType.Nas", "DeviceType.Printer", "DeviceType.Camera", "DeviceType.Plc", "DeviceType.Scanner",
        "DeviceType.Ups", "DeviceType.Other"
    ];

    protected override string EntityLabel => L["Entity.Device"];

    protected override List<GridColumn<DeviceEntry>> BuildColumns() =>
    [
        SiteColumn(),
        new() { Title = L["Col.Name"], Value = d => d.Name, Template = d => @<b>@d.Name</b> },
        new() { Title = L["Col.Type"], Value = d => d.DeviceType, SelectFilter = true },
        new() { Title = L["Col.Manufacturer"], Value = d => d.Manufacturer, SelectFilter = true },
        new() { Title = L["Col.Model"], Value = d => d.Model },
        IpColumn(L["Col.Ip"], d => d.IpAddress),
        new() { Title = L["Col.Mac"], Value = d => d.MacAddress, CssClass = "mono" },
        new() { Title = L["Col.State"], Value = d => d.State, SelectFilter = true,
                Template = d => @<StatusBadge Status="@d.State" Fallback="–" /> },
        new() { Title = L["Col.Firmware"], Value = d => d.FirmwareVersion },
        new() { Title = L["Col.MountLocation"], Value = d => d.Location },
        SourceColumn(),
        NotesColumn()
    ];

    protected override bool Matches(DeviceEntry d, string t) =>
        Has(d.Name, t) || Has(d.Model, t) || Has(d.IpAddress, t) || Has(d.MacAddress, t) || Has(d.FirmwareVersion, t)
        || Has(d.Manufacturer, t) || Has(d.DeviceType, t) || Has(d.Location, t);

    protected override void CopyEditable(DeviceEntry f, DeviceEntry t)
    {
        t.Name = f.Name.Trim();
        t.DeviceType = Fmt.Clean(f.DeviceType);
        t.Manufacturer = Fmt.Clean(f.Manufacturer);
        t.Model = Fmt.Clean(f.Model);
        t.IpAddress = Fmt.Clean(f.IpAddress);
        t.MacAddress = Fmt.Clean(f.MacAddress)?.ToLowerInvariant();
        t.State = Fmt.Clean(f.State);
        t.FirmwareVersion = Fmt.Clean(f.FirmwareVersion);
        t.Location = Fmt.Clean(f.Location);
        t.Features = Fmt.Clean(f.Features);
    }

    protected override void InitNew(DeviceEntry d) => d.State = "ONLINE";

    protected override string? Validate(DeviceEntry d) =>
        string.IsNullOrWhiteSpace(d.Name) ? L["Error.NameRequired"] : null;

    protected override string DisplayName(DeviceEntry d) => d.Name;
}
