@page "/"
@inject Texts L
@inject IDbContextFactory<HomelabAtlasDbContext> DbFactory
@inject SyncService Sync

<PageTitle>@L["Nav.Overview"] – HomelabAtlas</PageTitle>

<h1>@L["Nav.Overview"]</h1>

<div class="toolbar">
    <button class="btn primary" @onclick="SyncAll" disabled="@busy">@(busy ? L["Home.Syncing"] : L["Home.SyncAll"])</button>
    <a class="btn" href="export/markdown" download data-enhance-nav="false">@L["Home.ExportAll"]</a>
    <a class="btn" href="export/pdf" download data-enhance-nav="false">@L["Home.ExportAllPdf"]</a>
</div>

@if (stats.Count == 0)
{
    <p class="muted">@L["Home.Empty"] <a href="gateways">@L["Home.EmptyLink"]</a></p>
}

<div class="cards">
    @foreach (var s in stats)
    {
        var g = s.Gateway;
        <div class="card">
            <div class="card-head">
                <h2>@g.Name</h2>
                <StatusBadge Status="@(g.IsManual ? "Manual" : g.LastSyncStatus)" />
            </div>
            <div class="muted">
                <span class="badge kind">@L.Kind(g.Kind)</span>
                @if (!g.IsManual) { <text> @g.Host</text> }
                @if (!string.IsNullOrWhiteSpace(g.Location)) { <text> · @g.Location</text> }
                @if (!string.IsNullOrWhiteSpace(g.ApplicationVersion)) { <text> · @g.ApplicationVersion</text> }
            </div>
            <div class="kpis">
                <a href="networks?gatewayId=@g.Id"><b>@s.Networks</b><span>@L["Kpi.Networks"]</span></a>
                <a href="devices?gatewayId=@g.Id"><b>@s.Devices</b><span>@L["Kpi.Devices"]</span></a>
                <a href="clients?gatewayId=@g.Id"><b>@s.Clients</b><span>@L["Kpi.Clients"]</span></a>
                <a href="firewall?gatewayId=@g.Id"><b>@s.Policies</b><span>@L["Kpi.Rules"]</span></a>
            </div>
            <div class="muted small">
                @(L["Home.SitesInfo", s.Sites, s.Manual])
                @if (!g.IsManual) { <text> · @(L["Home.LastSync", Fmt.Time(g.LastSyncUtc)])</text> }
            </div>
            @if (!string.IsNullOrEmpty(g.LastSyncError))
            {
                <pre class="warnbox">@g.LastSyncError</pre>
            }
            <div class="toolbar">
                <a class="btn small" href="@($"export/markdown?gatewayId={g.Id}")" download data-enhance-nav="false">@L["Home.ExportLocation"]</a>
                <a class="btn small" href="@($"export/pdf?gatewayId={g.Id}")" download data-enhance-nav="false">@L["Home.ExportLocationPdf"]</a>
            </div>
        </div>
    }
</div>

@code {
    private sealed record Stat(Gateway Gateway, int Sites, int Networks, int Devices, int Clients, int Policies, int Manual);

    private List<Stat> stats = new();
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var gateways = await db.Gateways.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        var result = new List<Stat>();
        foreach (var g in gateways)
        {
            var manual =
                await db.Networks.CountAsync(x => x.Site!.GatewayId == g.Id && x.IsManual)
                + await db.Devices.CountAsync(x => x.Site!.GatewayId == g.Id && x.IsManual)
                + await db.Clients.CountAsync(x => x.Site!.GatewayId == g.Id && x.IsManual)
                + await db.FirewallZones.CountAsync(x => x.Site!.GatewayId == g.Id && x.IsManual)
                + await db.FirewallPolicies.CountAsync(x => x.Site!.GatewayId == g.Id && x.IsManual);

            result.Add(new Stat(g,
                await db.Sites.CountAsync(x => x.GatewayId == g.Id),
                await db.Networks.CountAsync(x => x.Site!.GatewayId == g.Id),
                await db.Devices.CountAsync(x => x.Site!.GatewayId == g.Id),
                await db.Clients.CountAsync(x => x.Site!.GatewayId == g.Id),
                await db.FirewallPolicies.CountAsync(x => x.Site!.GatewayId == g.Id),
                manual));
        }
        stats = result;
    }

    private async Task SyncAll()
    {
        busy = true;
        try { await Sync.SyncAllAsync(CancellationToken.None); }
        finally { busy = false; }
        await LoadAsync();
    }
}
