@page "/networks"
@inherits ListPageBase<NetworkEntry>

<PageTitle>@L["Nav.Networks"] – HomelabAtlas</PageTitle>

<h1>@L["Nav.Networks"]</h1>

<FilterBar Gateways="GatewayList" @bind-GatewayId="GatewayFilter" @bind-Search="Search">
    <button class="btn primary" @onclick="NewItem">+ @L["Networks.Add"]</button>
</FilterBar>

<DataGrid TItem="NetworkEntry" Items="Filtered" Columns="Columns" Key="x => x.Id"
          RowClass="RowCss" CanEdit="IsEditable" OnEdit="EditItem" OnDelete="DeleteAsync">
    <DetailTemplate Context="n">
        <RowDetails TEntity="NetworkEntry" Item="n" />
    </DetailTemplate>
</DataGrid>

@if (Editing is not null)
{
    <EditDialog Title="@EditTitle" Error="@EditError" OnSave="SaveAsync" OnCancel="CancelEdit">
        <SiteSelect Sites="SiteList" @bind-Value="Editing.SiteId" />
        <label>@L["Field.Name"]<input @bind="Editing.Name" placeholder="@L["Networks.NamePh"]" /></label>
        <label>@L["Field.VlanId"]<input type="number" min="1" max="4094" @bind="Editing.VlanId" /></label>
        <label>@L["Field.Subnet"]<input @bind="Editing.Subnet" placeholder="10.20.30.0/24" /></label>
        <label>@L["Field.Gateway"]<input @bind="Editing.GatewayIp" placeholder="10.20.30.1" /></label>
        <label>@L["Field.Management"]<input @bind="Editing.Management" list="net-types" placeholder="@L["Networks.ManagementPh"]" /></label>
        <datalist id="net-types">
            @foreach (var key in NetworkTypeKeys)
            {
                <option value="@L[key]"></option>
            }
        </datalist>
        <label>@L["Field.Dhcp"]<input @bind="Editing.DhcpMode" list="dhcp-modes" placeholder="SERVER, RELAY, NONE" /></label>
        <datalist id="dhcp-modes">
            <option value="SERVER"></option><option value="RELAY"></option><option value="NONE"></option>
        </datalist>
        <label>@L["Field.DhcpRange"]<input @bind="Editing.DhcpRange" placeholder="10.20.30.100 – 10.20.30.200" /></label>
        <label class="check"><input type="checkbox" @bind="Editing.Enabled" /> @L["Field.Enabled"]</label>
        <label class="wide">@L["Field.Notes"]<textarea rows="3" @bind="Editing.Notes"></textarea></label>
    </EditDialog>
}

@code {
    private static readonly string[] NetworkTypeKeys =
        ["NetType.External", "NetType.Provider", "NetType.Transfer", "NetType.Management", "NetType.Dmz", "NetType.Vpn", "NetType.Iot", "NetType.Guest"];

    protected override string EntityLabel => L["Entity.Network"];

    protected override List<GridColumn<NetworkEntry>> BuildColumns() =>
    [
        SiteColumn(),
        new() { Title = L["Col.Name"], Value = n => n.Name,
                Template = n => @<span><b>@n.Name</b><span class="muted small">@(n.IsDefault ? " " + L["Networks.Default"] : "")</span></span> },
        new() { Title = L["Col.Vlan"], Value = n => n.VlanId?.ToString(), SortKey = n => n.VlanId },
        IpColumn(L["Col.Subnet"], n => n.Subnet),
        IpColumn(L["Col.Gateway"], n => n.GatewayIp),
        new() { Title = L["Col.Dhcp"], Value = n => n.DhcpMode, SelectFilter = true },
        new() { Title = L["Col.DhcpRange"], Value = n => n.DhcpRange, CssClass = "mono" },
        new() { Title = L["Col.Type"], Value = n => n.Management, SelectFilter = true },
        new() { Title = L["Col.Enabled"], Value = n => L.YesNo(n.Enabled), SelectFilter = true },
        SourceColumn(),
        NotesColumn()
    ];

    protected override bool Matches(NetworkEntry n, string t) =>
        Has(n.Name, t) || Has(n.Subnet, t) || Has(n.GatewayIp, t) || Has(n.Management, t) || n.VlanId?.ToString() == t;

    protected override void CopyEditable(NetworkEntry f, NetworkEntry t)
    {
        t.Name = f.Name.Trim();
        t.VlanId = f.VlanId;
        t.Subnet = Fmt.Clean(f.Subnet);
        t.GatewayIp = Fmt.Clean(f.GatewayIp);
        t.Management = Fmt.Clean(f.Management);
        t.DhcpMode = Fmt.Clean(f.DhcpMode);
        t.DhcpRange = Fmt.Clean(f.DhcpRange);
        t.Enabled = f.Enabled;
    }

    protected override string? Validate(NetworkEntry n)
    {
        if (string.IsNullOrWhiteSpace(n.Name)) return L["Error.NameRequired"];
        if (n.VlanId is < 1 or > 4094) return L["Error.VlanRange"];
        return null;
    }

    protected override string DisplayName(NetworkEntry n) => n.Name;
}
